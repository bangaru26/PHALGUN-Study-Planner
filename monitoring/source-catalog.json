{
  "schema_version": 1,
  "policy": {
    "detection": "A source-page fingerprint change is a review signal, not proof that a legal rule changed.",
    "review_required_for": [
      "legal_effect",
      "effective_date",
      "jurisdiction",
      "lesson_changes",
      "assessment_changes"
    ],
    "unchanged_means": "The fetched page fingerprint is unchanged since the previous successful check; it does not prove the law or product is unchanged elsewhere."
  },
